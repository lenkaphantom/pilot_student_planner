<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_home.xml — FINALNA VERZIJA
    Zamenjuje prethodnu verziju sa include tagovima.
    Obaveze se sada pune dinamički kroz RecyclerView.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pilot_background">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="91dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="52dp"
            android:paddingBottom="12dp">

            <!-- ── HEADER ── -->
            <TextView
                android:id="@+id/tv_greeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dobro jutro, Igor"
                android:textColor="@color/pilot_dark"
                android:textSize="24sp"
                android:textFontWeight="800"
                android:fontFamily="@font/inter_bold" />

            <TextView
                android:id="@+id/tv_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Petak, 23. maj 2026."
                android:textColor="@color/pilot_dark"
                android:textSize="18sp"
                android:textFontWeight="600"
                android:fontFamily="@font/inter_regular" />

            <!-- ── KARTICA: Nastavi gde si stao ── -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_nastavi_ucenje"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardBackgroundColor="@color/pilot_purple_main"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/nastavi_gde_si_stao"
                        android:textColor="@color/pilot_purple_light"
                        android:textSize="18sp"
                        android:fontFamily="@font/inter_semibold" />

                    <TextView
                        android:id="@+id/tv_nastavi_subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/pilot_purple_light"
                        android:textSize="12sp"
                        android:fontFamily="@font/inter_regular" />

                    <ProgressBar
                        android:id="@+id/progress_nastavi"
                        style="@android:style/Widget.ProgressBar.Horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="16dp"
                        android:layout_marginTop="12dp"
                        android:progressDrawable="@drawable/progress_bar_purple"
                        android:indeterminate="false" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_nastavi_ucenje"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_gravity="end"
                        android:layout_marginTop="12dp"
                        android:text="@string/btn_nastavi_ucenje"
                        android:textColor="@color/pilot_purple_light"
                        android:textSize="12sp"
                        android:fontFamily="@font/inter_semibold"
                        app:backgroundTint="@color/pilot_purple2_main"
                        app:cornerRadius="8dp"
                        android:textAllCaps="false"/>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ── SEKCIJA: Predstojeće obaveze ── -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="10dp"
                android:text="@string/section_predstojeće_obaveze"
                android:textColor="@color/pilot_gray_border"
                android:textSize="18sp"
                android:textFontWeight="500"
                android:fontFamily="@font/inter_semibold" />

            <!-- Prazno stanje -->
            <TextView
                android:id="@+id/layout_empty_obaveze"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nema predstojećih obaveza 🎉"
                android:textColor="@color/pilot_gray_text"
                android:textSize="12sp"
                android:fontFamily="@font/inter_regular"
                android:textAlignment="center"
                android:paddingVertical="16dp"
                android:visibility="gone" />

            <!-- RecyclerView za obaveze -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_obaveze"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never" />

            <!-- ── SEKCIJA: Prilike za tebe ── -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="10dp"
                android:text="@string/section_prilike_za_tebe"
                android:textColor="@color/pilot_gray_border"
                android:textSize="18sp"
                android:textFontWeight="500"
                android:fontFamily="@font/inter_semibold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2"
                android:layout_marginBottom="16dp">

                <include
                    layout="@layout/item_prilika_home"
                    android:id="@+id/item_prilika_1"
                    android:layout_width="0dp"
                    android:layout_height="183dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp" />

                <include
                    layout="@layout/item_prilika_home"
                    android:id="@+id/item_prilika_2"
                    android:layout_width="0dp"
                    android:layout_height="183dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp" />

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ── BOTTOM NAVIGATION ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="@color/white">

        <!-- Gornja linija -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/pilot_gray_surface" />

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottom_nav"
            style="@style/Widget.Pilot.BottomNav"
            android:layout_width="match_parent"
            android:layout_height="91dp"
            android:background="@color/white"
            android:paddingBottom="27dp"
            app:menu="@menu/bottom_nav_menu"
            app:labelVisibilityMode="labeled"
            app:itemTextColor="@color/selector_bottom_nav_text"
            app:itemIconTint="@color/selector_bottom_nav_text" />

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>