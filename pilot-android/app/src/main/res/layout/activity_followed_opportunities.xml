<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pilot_background">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="110dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/pilot_gray_surface" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Kategorije obaveštenja"
                    android:textColor="@color/pilot_gray_text"
                    android:textSize="16sp"
                    android:fontFamily="@font/inter_medium" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/pilot_gray_surface"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="12dp" />

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@android:color/white"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="8dp">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="54dp">
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:layout_centerVertical="true">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Praksa u IT kompaniji"
                                    android:textColor="@color/pilot_dark"
                                    android:textSize="16sp" />
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="3 aktivne prakse"
                                    android:textColor="@color/pilot_gray_text"
                                    android:textSize="12sp" />
                            </LinearLayout>
                            <androidx.appcompat.widget.SwitchCompat
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:checked="true" />
                        </RelativeLayout>
                        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/pilot_gray_surface" />

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="54dp">
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:layout_centerVertical="true">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Stipendije"
                                    android:textColor="@color/pilot_dark"
                                    android:textSize="16sp" />
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="5 aktivnih konkursa"
                                    android:textColor="@color/pilot_gray_text"
                                    android:textSize="12sp" />
                            </LinearLayout>
                            <androidx.appcompat.widget.SwitchCompat
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:checked="true" />
                        </RelativeLayout>
                        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/pilot_gray_surface" />

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="54dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Razmene (Erasmus...)"
                                android:textColor="@color/pilot_dark"
                                android:textSize="16sp"
                                android:layout_centerVertical="true"/>
                            <androidx.appcompat.widget.SwitchCompat
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:checked="false" />
                        </RelativeLayout>
                        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/pilot_gray_surface" />

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="54dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Takmičenja"
                                android:textColor="@color/pilot_dark"
                                android:textSize="16sp"
                                android:layout_centerVertical="true"/>
                            <androidx.appcompat.widget.SwitchCompat
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:checked="false" />
                        </RelativeLayout>
                        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/pilot_gray_surface" />

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="54dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Volonterstvo"
                                android:textColor="@color/pilot_dark"
                                android:textSize="16sp"
                                android:layout_centerVertical="true"/>
                            <androidx.appcompat.widget.SwitchCompat
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:checked="false" />
                        </RelativeLayout>
                        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/pilot_gray_surface" />

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="54dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Studentske organizacije"
                                android:textColor="@color/pilot_dark"
                                android:textSize="16sp"
                                android:layout_centerVertical="true"/>
                            <androidx.appcompat.widget.SwitchCompat
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:checked="false" />
                        </RelativeLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sačuvane prilike"
                    android:textColor="@color/pilot_gray_text"
                    android:textSize="16sp"
                    android:fontFamily="@font/inter_medium" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/pilot_gray_surface"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="16dp" />

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@android:color/white"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/tv_title_1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_toStartOf="@id/btn_delete_1"
                            android:layout_alignParentStart="true"
                            android:text="Internship - Nordeus"
                            android:textColor="@color/pilot_dark"
                            android:textSize="18sp"
                            android:fontFamily="@font/inter_bold" />

                        <ImageView
                            android:id="@+id/btn_delete_1"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_alignParentEnd="true"
                            android:layout_marginTop="2dp"
                            android:src="@android:drawable/ic_menu_close_clear_cancel"
                            app:tint="@color/pilot_gray_text" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/tv_title_1"
                            android:layout_marginTop="12dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="#EEEDF9"
                                android:paddingHorizontal="10dp"
                                android:paddingVertical="4dp"
                                android:text="Praksa"
                                android:textColor="@color/pilot_purple_main"
                                android:textSize="13sp"
                                android:fontFamily="@font/inter_semibold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="16dp"
                                android:text="Rok: 1. jun 2026."
                                android:textColor="@color/pilot_gray_text"
                                android:textSize="13sp" />
                        </LinearLayout>
                    </RelativeLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="32dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@android:color/white"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/tv_title_2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_toStartOf="@id/btn_delete_2"
                            android:layout_alignParentStart="true"
                            android:text="Stipendija grada Novog Sada"
                            android:textColor="@color/pilot_dark"
                            android:textSize="18sp"
                            android:fontFamily="@font/inter_bold" />

                        <ImageView
                            android:id="@+id/btn_delete_2"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_alignParentEnd="true"
                            android:layout_marginTop="2dp"
                            android:src="@android:drawable/ic_menu_close_clear_cancel"
                            app:tint="@color/pilot_gray_text" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/tv_title_2"
                            android:layout_marginTop="12dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="#EAF7F0"
                                android:paddingHorizontal="10dp"
                                android:paddingVertical="4dp"
                                android:text="Stipendija"
                                android:textColor="#27AE60"
                                android:textSize="13sp"
                                android:fontFamily="@font/inter_semibold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="16dp"
                                android:text="Rok: 1. jun 2026."
                                android:textColor="@color/pilot_gray_text"
                                android:textSize="13sp" />
                        </LinearLayout>
                    </RelativeLayout>
                </androidx.cardview.widget.CardView>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_save"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:text="Sačuvaj izmene"
                    android:textColor="@android:color/white"
                    android:textSize="16sp"
                    android:textAllCaps="false"
                    app:backgroundTint="@color/pilot_purple_main"
                    app:cornerRadius="12dp" />

            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="@android:color/white">
        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/pilot_gray_surface" />
        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottom_nav"
            style="@style/Widget.Pilot.BottomNav"
            android:layout_width="match_parent"
            android:layout_height="91dp"
            android:background="@android:color/white"
            android:paddingBottom="27dp"
            app:menu="@menu/bottom_nav_menu"
            app:labelVisibilityMode="labeled"
            app:itemTextColor="@color/selector_bottom_nav_text"
            app:itemIconTint="@color/selector_bottom_nav_text" />
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>