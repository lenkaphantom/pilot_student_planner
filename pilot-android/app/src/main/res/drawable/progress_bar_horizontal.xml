<?xml version="1.0" encoding="utf-8"?>
<!--
    progress_bar_horizontal.xml
    ─────────────────────────────────────────────
    Horizontalni progress bar za setup/onboarding flow.
    Koristi se na RegisterActivity i OnboardingActivity.

    Track : pilot_purple_light  (#EBEBF5)
    Fill  : pilot_purple2_main  (#534AB7)
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Track (pozadina) -->
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <corners android:radius="2dp" />
            <solid android:color="@color/pilot_purple_light" />
        </shape>
    </item>

    <!-- Sekundarni progres (nije korišten, ali mora biti definisan) -->
    <item android:id="@android:id/secondaryProgress">
        <clip>
            <shape android:shape="rectangle">
                <corners android:radius="2dp" />
                <solid android:color="#00000000" />
            </shape>
        </clip>
    </item>

    <!-- Primarni progres (fill) -->
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <corners android:radius="2dp" />
                <solid android:color="@color/pilot_purple2_main" />
            </shape>
        </clip>
    </item>

</layer-list>

