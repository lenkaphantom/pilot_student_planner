<?xml version="1.0" encoding="utf-8"?>
<!--
    progress_bar_purple.xml
    ─────────────────────────────────────────────
    Standardni progress bar na svetloj pozadini.
    Koristi se na Kalendar, Plan učenja i slično.

    Track : pilot_purple_light  (#EBEBF5)
    Fill  : pilot_purple2_main  (#534AB7)
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="@color/pilot_purple_light" />
        </shape>
    </item>

    <item android:id="@android:id/secondaryProgress">
        <clip>
            <shape android:shape="rectangle">
                <corners android:radius="8dp" />
                <solid android:color="#00000000" />
            </shape>
        </clip>
    </item>

    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <corners android:radius="8dp" />
                <solid android:color="@color/pilot_purple2_main" />
            </shape>
        </clip>
    </item>

</layer-list>